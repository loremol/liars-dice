# Script mode: converts a binary file into a C++ source/header pair.
#
#   cmake -DINPUT=<file> -DOUTPUT_CPP=<cpp> -DOUTPUT_HPP=<hpp> -DSYMBOL=<name>
#         -P embed_file.cmake
#
# Defines liars_dice::assets::<SYMBOL> (const unsigned char[]) and
# liars_dice::assets::<SYMBOL>Size (std::size_t).

foreach(variable INPUT OUTPUT_CPP OUTPUT_HPP SYMBOL)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "embed_file.cmake: ${variable} is not set")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
if(size EQUAL 0)
    message(FATAL_ERROR "embed_file.cmake: ${INPUT} is empty")
endif()

string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# CMake regex has no {n} quantifier: spell out 16 bytes per line.
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)
string(REGEX REPLACE "(${line_pattern})" "\\1\n" bytes "${bytes}")

get_filename_component(header_name "${OUTPUT_HPP}" NAME)

file(WRITE "${OUTPUT_HPP}" "// Generated by cmake/embed_file.cmake. Do not edit.
#pragma once

#include <cstddef>

namespace liars_dice::assets {

extern const unsigned char ${SYMBOL}[];
extern const std::size_t ${SYMBOL}Size;

}  // namespace liars_dice::assets
")

file(WRITE "${OUTPUT_CPP}" "// Generated by cmake/embed_file.cmake. Do not edit.
#include \"${header_name}\"

namespace liars_dice::assets {

const unsigned char ${SYMBOL}[] = {
${bytes}
};

const std::size_t ${SYMBOL}Size = ${size};

}  // namespace liars_dice::assets
")
